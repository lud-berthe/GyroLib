/CMakeFiles/
/Testing/
/cmake_install.cmake
/install_manifest*.txt
/Makefile
/build.ninja
/rules.ninja
/.ninja_*
/CMakeUserPresets.json
/*.sln
/*.vcxproj*
/*.exe
/*.dll
/*.lib
/*.a
/*.so
