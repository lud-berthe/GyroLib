+/* Altered SDL: optional per-window input bridge, before SDL mouse state.
+ * The property lock also makes unregistration wait for in-flight raw callbacks. */
+static bool GyroLibFilterRawMouse(SDL_Window *window, HANDLE device, RAWMOUSE *raw)
+{
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    bool consumed = false;
+    if (SDL_LockProperties(props)) {
+        GyroLibSDLMouseFilter *filter = SDL_GetPointerProperty(props, GL_SDL_MOUSE_FILTER, NULL);
+        if (filter && filter->raw) {
+            consumed = filter->raw(filter->user, (Uint64)(uintptr_t)device,
+                (raw->usFlags & MOUSE_MOVE_ABSOLUTE) != 0, raw->usButtonFlags, raw->lLastX, raw->lLastY);
+        }
+        SDL_UnlockProperties(props);
+    }
+    return consumed;
+}
+static bool GyroLibFilterMessage(SDL_Window *window, HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    bool consumed = false;
+    if (SDL_LockProperties(props)) {
+        GyroLibSDLMouseFilter *filter = SDL_GetPointerProperty(props, GL_SDL_MOUSE_FILTER, NULL);
+        if (filter && filter->message) {
+            consumed = filter->message(filter->user, hwnd, msg, (Uint64)wp, (Sint64)lp);
+        }
+        SDL_UnlockProperties(props);
+    }
+    return consumed;
+}
