+inline bool GamepadMotion::InitializeGravityFromAcceleration(float x, float y, float z)
+{
+	if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z)) return false;
+	const float magnitude = sqrtf(x*x + y*y + z*z);
+	if (!std::isfinite(magnitude) || magnitude < 0.05f || magnitude > 3.5f) return false;
+	Motion.Grav.Set(-x / magnitude, -y / magnitude, -z / magnitude);
+	Motion.SmoothAccel.Set(x, y, z);
+	Motion.Accel = Motion.SmoothAccel + Motion.Grav;
+	Motion.Shakiness = 0.f;
+	return true;
+}
